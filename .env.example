# Database
DB_NAME=pma_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API / Auth
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_base64_48
FRONTEND_ORIGIN=https://sigtar.gobiernogalapagos.gob.ec
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1

# Storage (NAS Synology - URL publica del API para servir archivos)
STORAGE_PUBLIC_BASE_URL=https://sigtar.gobiernogalapagos.gob.ec/storage

# Nginx (produccion)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SSL_CERT_DIR=/etc/ssl/cgreg

# SMTP (ej. Amazon SES). Es obligatorio en producción para entregar invitaciones y recuperaciones.
SMTP_HOST=email-smtp.us-west-2.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_ses_smtp_username
SMTP_PASS=your_ses_smtp_password
# Debe ser una identidad verificada en SES (dominio o correo verificado).
SMTP_FROM="PMA Management <no-reply@tudominio.com>"

# Galápagos Previene (reportes ciudadanos)
# La API de reportes publica en 127.0.0.1:8080 del HOST — solo loopback — así
# que host.docker.internal (que resuelve al puente Docker) NO la alcanza:
# devuelve ECONNREFUSED. Se llega por la red dedicada `sigtar-previene-link`,
# donde el contenedor responde a su propio nombre. Ver el bloque `networks:` de
# docker-compose.yml para por qué es una red aparte y no la de ese proyecto.
PREVIENE_API_BASE_URL=http://galapagos-previene-api:8080
# Clave Bearer de la API de reportes. Nunca llega al navegador: la API del
# SIGTAR actúa de proxy. Sin este valor el módulo arranca en modo desconectado.
PREVIENE_API_KEY=
# Cada cuánto sincroniza el worker (ms). El pliego pide entre 1 y 5 minutos.
PREVIENE_SYNC_INTERVAL_MS=120000
