# Firebase Admin SDK service account
# Either FIREBASE_ADMIN_PROJECT_ID + CLIENT_EMAIL + PRIVATE_KEY,
# or GOOGLE_APPLICATION_CREDENTIALS pointing at a service-account JSON.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google OAuth (for downloading Drive files using per-admin tokens stored in Firestore)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Target Postgres
DATABASE_URL=postgresql://pma_app:password@localhost:5432/pma_management?sslmode=disable

# Synology mount (final destination of files)
STORAGE_ROOT=./files-staging

# Staging directories (created by scripts)
DUMP_DIR=./dump
FILES_DIR=./files
MANIFEST_FILE=./drive-manifest.json
REPORT_FILE=./verify-report.json
