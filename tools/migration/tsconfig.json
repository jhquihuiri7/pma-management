{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@pma/types": ["../../packages/types/src/index.ts"],
      "@pma/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["*.ts", "../../apps/api/src/db/schema/**/*.ts"]
}
