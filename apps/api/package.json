{
  "name": "@pma/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "worker:watch": "tsx watch src/worker.ts",
    "worker:start": "node dist/apps/api/src/worker.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --require tsx/cjs ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx src/db/run-migrations.ts",
    "db:push": "node --require tsx/cjs ../../node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --require tsx/cjs ../../node_modules/drizzle-kit/bin.cjs studio",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:admin:env": "tsx src/scripts/seed-admin-env.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@pma/types": "*",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "fastify": "^4.28.1",
    "jose": "^5.9.6",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "pg-boss": "^10.4.2",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
