# Server
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# JWT secrets (use openssl rand -base64 48 in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# PostgreSQL
DATABASE_URL=postgresql://pma_app:password@localhost:5432/pma_management?sslmode=disable

# Storage (Synology SMB mount in production, local fs in dev)
STORAGE_ROOT=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/storage

# Rasters / orthophotos. Per-request upload cap for .tif/.tiff (streamed to NAS,
# never buffered). Default ~5.5 GB. RASTER_KEEP_ORIGINAL keeps the original after
# the COG is generated (Phase 5).
RASTER_MAX_UPLOAD_BYTES=5905580032
RASTER_KEEP_ORIGINAL=true

# SMTP (ej. Amazon SES). Si SMTP_HOST queda vacio, los correos no se enviaran.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Debe ser una identidad verificada en SES (dominio o correo verificado).
SMTP_FROM="PMA Management <no-reply@tudominio.com>"
