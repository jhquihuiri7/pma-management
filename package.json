{
  "name": "pma-management",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@pma/web",
    "dev:api": "npm run dev --workspace=@pma/api",
    "build:web": "npm run build --workspace=@pma/web",
    "build:api": "npm run build --workspace=@pma/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
