+/// SIGTAR: the layer the Layers pane acts on — the active map layer, else the picked tile layer.
+fn active_now(s: &rustgis_ui_egui::rustgis_engine::Session) -> Option<crate::embed::Active> {
+    if let Some(id) = s.active_layer {
+        return Some(crate::embed::Active::Layer(id));
+    }
+    let i = s.selected_tile()?;
+    s.map().tiles.get(i).map(|t| crate::embed::Active::Tile(t.url.clone()))
+}
+
+/// SIGTAR: makes the layer a project was saved with active again, when it is still in it.
+fn restore_active(app: &mut RustGisApp, active: Option<crate::embed::Active>) {
+    let s = &mut app.session;
+    match active {
+        Some(crate::embed::Active::Layer(id)) => {
+            if s.map().layers.iter().any(|l| l.id == id) {
+                s.active_layer = Some(id);
+            }
+        }
+        Some(crate::embed::Active::Tile(url)) => {
+            let index = s.project.active_map;
+            if let Some(map) = s.project.maps.get_mut(index)
+                && map.tiles.iter().any(|t| t.url == url)
+            {
+                for t in &mut map.tiles {
+                    t.selected = t.url == url;
+                }
+                s.active_layer = None;
+            }
+        }
+        None => {}
+    }
+}
+
+/// SIGTAR: embedded in the geoportal, the assistant starts on the geoportal's own model proxy, on
+/// the page's own origin, so the provider's key stays on the server and nothing is typed in each
+/// visit. Set when the app is built (`RUSTGIS_EMBED_ASSISTANT_PATH`, `…_MODEL`), never by the page
+/// that frames it: any page may frame the app, and it must not be able to point the assistant
+/// elsewhere. The user can still change these for the visit.
+fn seed_assistant(prefs: &mut HashMap<String, String>) {
+    use rustgis_ui_egui::rustgis_assistant::provider::{PROVIDER_PREF, url_pref};
+    let Some(path) = option_env!("RUSTGIS_EMBED_ASSISTANT_PATH").map(str::trim).filter(|p| p.starts_with('/')) else {
+        return;
+    };
+    let Some(origin) = web_sys::window().and_then(|w| w.location().origin().ok()) else {
+        return;
+    };
+    let model = option_env!("RUSTGIS_EMBED_ASSISTANT_MODEL").map(str::trim).filter(|m| !m.is_empty()).unwrap_or("sigtar-asistente");
+    prefs.insert(PROVIDER_PREF.to_string(), "custom".to_string());
+    prefs.insert(url_pref("custom"), format!("{origin}{path}"));
+    prefs.insert("assistant_model_custom".to_string(), model.to_string());
+}
