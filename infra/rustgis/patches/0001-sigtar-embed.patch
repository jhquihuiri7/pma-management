+/// The member of the active map that carries its active layer (SIGTAR addition).
+pub const ACTIVE_FIELD: &str = "sigtar_active";
+
+/// The layer the Layers pane acts on: a map layer by id, or a tile layer by its address.
+#[derive(Debug, Clone, PartialEq)]
+pub enum Active {
+    Layer(u32),
+    Tile(String),
+}
+
+/// Writes `active` into the active map of a serialized project, or removes the field.
+pub fn with_active(project: &mut Value, active: Option<&Active>) {
+    let index = project.get("active_map").and_then(Value::as_u64).unwrap_or(0) as usize;
+    let Some(map) = project.get_mut("maps").and_then(|m| m.get_mut(index)).and_then(Value::as_object_mut) else {
+        return;
+    };
+    match active {
+        Some(Active::Layer(id)) => {
+            map.insert(ACTIVE_FIELD.into(), json!({"layer": id}));
+        }
+        Some(Active::Tile(url)) => {
+            map.insert(ACTIVE_FIELD.into(), json!({"tile": url}));
+        }
+        None => {
+            map.remove(ACTIVE_FIELD);
+        }
+    }
+}
+
+/// The active layer a project's text names for its active map, if any.
+pub fn active_in(text: &str) -> Option<Active> {
+    let v: Value = serde_json::from_str(text).ok()?;
+    let index = v.get("active_map").and_then(Value::as_u64).unwrap_or(0) as usize;
+    let field = v.get("maps")?.get(index)?.get(ACTIVE_FIELD)?;
+    if let Some(id) = field.get("layer").and_then(Value::as_u64).and_then(|id| u32::try_from(id).ok()) {
+        return Some(Active::Layer(id));
+    }
+    field.get("tile").and_then(Value::as_str).filter(|u| !u.is_empty()).map(|u| Active::Tile(u.to_string()))
 }
 
