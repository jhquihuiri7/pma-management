+/// SIGTAR (pma-management): moves a layout's map series to `page` (0-based), its frame to that
+/// page's feature, as [`layout_bytes`] does before drawing each page. For an export of the series
+/// spread over the interface's frames: in the browser a whole series drawn at once holds the page
+/// for minutes, and its features read by range can't arrive while it does.
+pub fn series_goto(s: &mut Session, li: usize, page: usize) -> Result<(), String> {
+    series_page(s, &json!({"layout": li, "page": page})).map(|_| ())
+}
+
+/// SIGTAR: the layout `li` as it is now, drawn as page `page` (0-based) of `pages`, named `name`,
+/// at `dpi`, as one page of a PDF (compressed already).
+pub fn layout_pdf_page(s: &mut Session, li: usize, dpi: f64, page: usize, pages: usize, name: String) -> Result<rustgis_render::pdf::Page, String> {
+    let dpi = if dpi.is_finite() { dpi.clamp(36.0, 600.0) } else { 150.0 };
+    let layout = s.project.layouts.get(li).ok_or("no layout")?;
+    let info = rustgis_render::layout::PageInfo { page: page + 1, pages, page_name: name };
+    let img = rustgis_render::layout::render(layout, &mut s.project.maps, dpi, &info).ok_or("the page is too large to draw")?;
+    Ok(rustgis_render::pdf::Page::new(&img, layout.width, layout.height))
+}
+
 fn export(s: &mut Session, p: &Value) -> CmdResult {
     let path = ps(p, "path").ok_or("path is required")?.to_string();
     let li = index(s, p)?;
